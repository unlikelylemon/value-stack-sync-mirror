{
  "headers": [
    {
      "source": "/customerdeck",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/customerdeck-presentation.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/customerdeck-mobile.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/audit/:brand(petco|adidas)",
      "destination": "/audit/:brand/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/audit",
      "destination": "https://soa-audit.vercel.app/audit/"
    },
    {
      "source": "/audit/",
      "destination": "https://soa-audit.vercel.app/audit/"
    },
    {
      "source": "/audit/:brand(petco|adidas)/",
      "destination": "https://agentic-value-audit.vercel.app/:brand/index.html"
    },
    {
      "source": "/audit/:brand(petco|adidas)/:path+",
      "destination": "https://agentic-value-audit.vercel.app/:brand/:path+"
    },
    {
      "source": "/audit/:path*",
      "destination": "https://soa-audit.vercel.app/audit/:path*"
    },
    {
      "source": "/api/public/soa-lite",
      "destination": "https://soa-audit.vercel.app/api/public/soa-lite"
    },
    {
      "source": "/api/public/soa-lite/:path*",
      "destination": "https://soa-audit.vercel.app/api/public/soa-lite/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
